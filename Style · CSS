* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f5f9;
    color: #172033;
}

header {
    background: linear-gradient(135deg, #4338ca, #2563eb);
    color: white;
    text-align: center;
    padding: 25px 15px;
}

header h1 { margin: 0 0 10px; }
header p { margin: 0; }

main {
    max-width: 1000px;
    margin: 25px auto;
    padding: 0 15px;
}

.card {
    background: white;
    padding: 22px;
    margin-bottom: 20px;
    border-radius: 14px;
    box-shadow: 0 5px 20px #0000000d;
}

h2 {
    color: #4338ca;
    margin-top: 0;
}

input,
textarea {
    width: 100%;
    padding: 11px;
    margin: 8px 0 12px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    font-size: 15px;
}

textarea { min-height: 130px; }

button {
    padding: 11px 16px;
    border: none;
    border-radius: 7px;
    background: #4f46e5;
    color: white;
    cursor: pointer;
    margin: 5px 3px 5px 0;
}

button:hover { background: #3730a3; }

button:disabled {
    background: #94a3b8;
    cursor: not-allowed;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    padding: 8px 5px;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
}

td input {
    min-width: 60px;
    margin: 0;
}

.delete-btn { background: #dc2626; }
.delete-btn:hover { background: #b91c1c; }

#total { color: #15803d; }

#verification {
    padding: 12px;
    border-radius: 7px;
    background: #f1f5f9;
}

.history-item {
    border-bottom: 1px solid #e2e8f0;
    padding: 12px 0;
}

.history-item p { margin: 4px 0; }

@media (max-width: 600px) {
    .card { padding: 14px; }
    table { font-size: 12px; }
    th, td { padding: 5px 3px; }
}

@media print {
    header {
        background: white;
        color: black;
    }

    button,
    #billImage,
    #scanBtn,
    #scanStatus,
    textarea,
    #history {
        display: none;
    }

    body { background: white; }
    .card { box-shadow: none; }
}