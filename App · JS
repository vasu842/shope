let items = [];

function money(value) {
    return Math.round((Number(value) + Number.EPSILON) * 100) / 100;
}

function formatMoney(value) {
    return money(value).toFixed(2);
}

function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, character => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[character]);
}

// ---------- Item table ----------

function addItem(name = "", quantity = 1, price = 0) {
    items.push({ name, quantity, price });
    renderItems();
}

function renderItems() {
    const body = document.getElementById("itemsBody");
    body.innerHTML = "";

    items.forEach((item, index) => {
        const row = document.createElement("tr");

        row.innerHTML = `
            <td>
                <input value="${escapeHtml(item.name)}" aria-label="Item name"
                    onchange="updateItem(${index}, 'name', this.value)">
            </td>
            <td>
                <input type="number" min="0.001" step="0.001"
                    value="${item.quantity}" aria-label="Quantity"
                    onchange="updateItem(${index}, 'quantity', this.value)">
            </td>
            <td>
                <input type="number" min="0" step="0.01"
                    value="${item.price}" aria-label="Price"
                    onchange="updateItem(${index}, 'price', this.value)">
            </td>
            <td id="amount-${index}">
                ₹${formatMoney(item.quantity * item.price)}
            </td>
            <td>
                <button class="delete-btn" onclick="removeItem(${index})">X</button>
            </td>
        `;

        body.appendChild(row);
    });

    updateTotal();
}

// Updates only the amount and total, so typing focus is not lost
function updateItem(index, key, value) {
    if (key === "name") {
        items[index].name = value;
    } else {
        items[index][key] = Number(value);
    }

    const cell = document.getElementById("amount-" + index);
    if (cell) {
        cell.textContent =
            "₹" + formatMoney(items[index].quantity * items[index].price);
    }

    updateTotal();
}

function removeItem(index) {
    items.splice(index, 1);
    renderItems();
}

function calculateTotal() {
    return money(
        items.reduce(
            (sum, item) =>
                sum + money(Number(item.quantity) * Number(item.price)),
            0
        )
    );
}

function updateTotal() {
    document.getElementById("total").textContent = formatMoney(calculateTotal());
    verifyTotal();
}

function verifyTotal() {
    const input = document.getElementById("paperTotal").value;
    const result = document.getElementById("verification");

    if (input === "") {
        result.textContent = "Enter the total printed on the paper bill.";
        result.style.color = "#475569";
        return;
    }

    const paper = Number(input);

    if (!Number.isFinite(paper) || paper < 0) {
        result.textContent = "Enter a valid paper total.";
        result.style.color = "#dc2626";
        return;
    }

    const calculated = calculateTotal();

    if (Math.abs(paper - calculated) < 0.01) {
        result.textContent = "✓ MATCH — Both totals are ₹" + formatMoney(calculated);
        result.style.color = "#15803d";
    } else {
        result.textContent =
            "⚠ MISMATCH — Paper: ₹" + formatMoney(paper) +
            " | Calculated: ₹" + formatMoney(calculated) +
            " | Difference: ₹" + formatMoney(Math.abs(paper - calculated));
        result.style.color = "#dc2626";
    }
}

// ---------- OCR ----------

async function scanBill() {
    const file = document.getElementById("billImage").files[0];
    const status = document.getElementById("scanStatus");
    const button = document.getElementById("scanBtn");

    if (!file) {
        alert("Please choose a bill image.");
        return;
    }

    if (!file.type.startsWith("image/")) {
        alert("Please choose an image file.");
        return;
    }

    if (!window.Tesseract) {
        alert("OCR library unavailable. Check your internet connection.");
        return;
    }

    button.disabled = true;
    status.textContent = "Scanning bill... Please wait.";

    try {
        const result = await Tesseract.recognize(file, "eng", {
            logger: message => {
                if (message.status) {
                    status.textContent =
                        message.status +
                        (message.progress !== undefined
                            ? " " + Math.round(message.progress * 100) + "%"
                            : "");
                }
            }
        });

        document.getElementById("ocrText").value = result.data.text;
        status.textContent = "Scan completed. Review the text and extract items.";

    } catch (error) {
        status.textContent = "Scanning failed. Try a clearer image.";
    } finally {
        button.disabled = false;
    }
}

// Normalise one OCR line: remove currency marks, fix decimal commas
function cleanLine(line) {
    return line
        .replace(/₹|\brs\.?|\binr\b|\/-/gi, " ")
        .replace(/(\d),(\d{2})(?!\d)/g, "$1.$2")   // 50,00 -> 50.00
        .replace(/(\d),(?=\d{3}\b)/g, "$1")        // 1,250 -> 1250
        .replace(/\s+/g, " ")
        .trim();
}

// Extract probable items. Receipt formats vary, so always review the result.
function extractItems() {
    const lines = document.getElementById("ocrText").value
        .split(/\r?\n/)
        .map(cleanLine)
        .filter(Boolean);

    const SKIP = /\b(tax|gst|cgst|sgst|igst|discount|cash|change|round|phone|mobile|tel|invoice|bill\s*no|date|time|upi|card|thank)\b/i;
    const TOTAL = /\b(grand\s*total|net\s*(total|amount)|total\s*amount|amount\s*due|bill\s*total|total)\b/i;

    const rows = [];
    let detectedTotal = null;

    for (const line of lines) {
        if (/sub\s*total/i.test(line)) continue;

        if (TOTAL.test(line)) {
            const n = line.match(/\d+(?:\.\d+)?/g);
            if (n) detectedTotal = Number(n[n.length - 1]);
            continue;
        }

        if (SKIP.test(line)) continue;

        // up to 3 trailing numbers (qty, rate, amount); the rest is the name
        const tokens = line.split(" ");
        const nums = [];

        while (
            tokens.length > 1 &&
            nums.length < 3 &&
            /^\d+(\.\d+)?$/.test(tokens[tokens.length - 1])
        ) {
            nums.unshift(Number(tokens.pop()));
        }

        const name = tokens.join(" ").replace(/^[\d.)\-\s]+/, "").trim();

        if (!name || !/[a-z]/i.test(name) || nums.length === 0) continue;
        if (nums.some(n => n > 100000)) continue; // phone numbers etc.

        if (nums.length === 1) {
            rows.push({ name, a: { quantity: 1, price: nums[0] } });

        } else if (nums.length === 2) {
            const [q, b] = nums;

            if (q > 0 && q <= 100) {
                // ambiguous: b is the unit price (a) OR the line amount (b)
                rows.push({
                    name,
                    a: { quantity: q, price: b },
                    b: { quantity: q, price: money(b / q) }
                });
            } else {
                rows.push({ name, a: { quantity: 1, price: b } });
            }

        } else {
            const [q, rate, amount] = nums;
            const consistent = Math.abs(q * rate - amount) <= 0.51;

            rows.push({
                name,
                a: consistent || q <= 0
                    ? { quantity: q > 0 ? q : 1, price: rate }
                    : { quantity: q, price: money(amount / q) }
            });
        }
    }

    // choose the reading that best matches the paper total
    const paperInput = document.getElementById("paperTotal").value;
    const target = detectedTotal !== null
        ? detectedTotal
        : (paperInput !== "" ? Number(paperInput) : null);

    const sum = mode => rows.reduce((s, r) => {
        const x = r[mode] || r.a;
        return s + x.quantity * x.price;
    }, 0);

    let mode = "a";
    if (target !== null && Number.isFinite(target) &&
        Math.abs(sum("b") - target) < Math.abs(sum("a") - target)) {
        mode = "b";
    }

    const found = rows.map(r => ({ name: r.name, ...(r[mode] || r.a) }));

    if (found.length > 0) {
        items = found;
        renderItems();
    }

    if (detectedTotal !== null && Number.isFinite(detectedTotal)) {
        document.getElementById("paperTotal").value = detectedTotal.toFixed(2);
    }

    verifyTotal();

    alert(
        found.length
            ? "Items extracted. Please verify every item and price."
            : "No clear items found. Please add items manually."
    );
}

// ---------- Save and history ----------

async function saveBill() {
    if (items.length === 0) {
        alert("Add at least one item.");
        return;
    }

    const valid = items.every(item =>
        String(item.name).trim() !== "" &&
        Number.isFinite(Number(item.quantity)) && Number(item.quantity) > 0 &&
        Number.isFinite(Number(item.price)) && Number(item.price) >= 0
    );

    if (!valid) {
        alert("Check every item name, quantity and price.");
        return;
    }

    const paperValue = document.getElementById("paperTotal").value;
    const paperTotal = paperValue === "" ? null : Number(paperValue);

    if (paperTotal !== null && (!Number.isFinite(paperTotal) || paperTotal < 0)) {
        alert("Enter a valid paper total.");
        return;
    }

    const notes = document.getElementById("notes").value.trim();

    try {
        const response = await fetch("/api/bills", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                items: items.map(item => ({
                    name: String(item.name).trim(),
                    quantity: Number(item.quantity),
                    unitPrice: Number(item.price)
                })),
                paperTotal,
                notes
            })
        });

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || "Could not save bill.");
        }

        alert(
            "Bill saved successfully!\n" +
            "Bill ID: " + data.billId + "\n" +
            "Total: ₹" + formatMoney(data.total) + "\n" +
            "Verification: " + data.status
        );

        loadBills();

    } catch (error) {
        alert(error.message + "\nCheck that Node.js and MySQL are running.");
    }
}

async function loadBills() {
    const history = document.getElementById("history");

    try {
        const response = await fetch("/api/bills");
        const bills = await response.json();

        if (!response.ok) {
            throw new Error("Could not load billing history.");
        }

        if (bills.length === 0) {
            history.textContent = "No saved bills yet.";
            return;
        }

        history.innerHTML = "";

        bills.forEach(bill => {
            const div = document.createElement("div");
            div.className = "history-item";

            const lines = [
                "Total: ₹" + formatMoney(bill.calculated_total),
                "Status: " + bill.verification_status,
                bill.notes ? "Notes: " + bill.notes : null,
                new Date(bill.bill_date).toLocaleString()
            ].filter(Boolean);

            const title = document.createElement("strong");
            title.textContent = "Bill #" + bill.id;
            div.appendChild(title);

            lines.forEach(text => {
                const p = document.createElement("p");
                p.textContent = text;
                div.appendChild(p);
            });

            history.appendChild(div);
        });

    } catch (error) {
        history.textContent = "Could not load history. Check server and MySQL.";
    }
}

addItem();
loadBills();