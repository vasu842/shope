let items = [];

function money(value) {
    return Math.round(
        (Number(value) + Number.EPSILON) * 100
    ) / 100;
}

function formatMoney(value) {
    return money(value).toFixed(2);
}

// Add item
function addItem(name = "", quantity = 1, price = 0) {
    items.push({
        name,
        quantity,
        price
    });

    renderItems();
}

// Display items
function renderItems() {
    const body = document.getElementById("itemsBody");

    body.innerHTML = "";

    items.forEach((item, index) => {
        const row = document.createElement("tr");

        row.innerHTML = `
            <td>
                <input value="${escapeHtml(item.name)}"
                    aria-label="Item name"
                    onchange="updateItem(${index}, 'name', this.value)">
            </td>

            <td>
                <input type="number"
                    min="0.001"
                    step="0.001"
                    value="${item.quantity}"
                    onchange="updateItem(${index}, 'quantity', this.value)">
            </td>

            <td>
                <input type="number"
                    min="0"
                    step="0.01"
                    value="${item.price}"
                    onchange="updateItem(${index}, 'price', this.value)">
            </td>

            <td>
                ₹${formatMoney(item.quantity * item.price)}
            </td>

            <td>
                <button class="delete-btn"
                    onclick="removeItem(${index})">X</button>
            </td>
        `;

        body.appendChild(row);
    });

    updateTotal();
}

function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, character => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[character]);
}

function updateItem(index, key, value) {
    if (key === "name") {
        items[index].name = value;
    } else {
        items[index][key] = Number(value);
    }

    renderItems();
}

function removeItem(index) {
    items.splice(index, 1);
    renderItems();
}

function calculateTotal() {
    return money(
        items.reduce(
            (sum, item) =>
                sum + Number(item.quantity) * Number(item.price),
            0
        )
    );
}

function updateTotal() {
    document.getElementById("total").textContent =
        formatMoney(calculateTotal());

    verifyTotal();
}

// Verify paper amount
function verifyTotal() {
    const input = document.getElementById("paperTotal").value;
    const result = document.getElementById("verification");

    if (input === "") {
        result.textContent =
            "Enter the total printed on the paper bill.";

        result.style.color = "#475569";
        return;
    }

    const paper = Number(input);

    if (!Number.isFinite(paper) || paper < 0) {
        result.textContent = "Enter a valid paper total.";
        result.style.color = "#dc2626";
        return;
    }

    const calculated = calculateTotal();

    if (Math.abs(paper - calculated) < 0.01) {
        result.textContent =
            "✓ MATCH — Both totals are ₹" +
            formatMoney(calculated);

        result.style.color = "#15803d";
    } else {
        result.textContent =
            "⚠ MISMATCH — Paper: ₹" +
            formatMoney(paper) +
            " | Calculated: ₹" +
            formatMoney(calculated);

        result.style.color = "#dc2626";
    }
}

// OCR scan
async function scanBill() {
    const file = document.getElementById("billImage").files[0];
    const status = document.getElementById("scanStatus");

    if (!file) {
        alert("Please choose a bill image.");
        return;
    }

    if (!file.type.startsWith("image/")) {
        alert("Please choose an image file.");
        return;
    }

    if (!window.Tesseract) {
        alert("OCR library unavailable. Check your internet connection.");
        return;
    }

    status.textContent = "Scanning bill... Please wait.";

    try {
        const result = await Tesseract.recognize(file, "eng", {
            logger: message => {
                if (message.status) {
                    status.textContent =
                        message.status +
                        (message.progress !== undefined
                            ? " " + Math.round(message.progress * 100) + "%"
                            : "");
                }
            }
        });

        document.getElementById("ocrText").value =
            result.data.text;

        status.textContent =
            "Scan completed. Review the text and extract items.";

    } catch (error) {
        status.textContent = "Scanning failed. Try a clearer image.";
    }
}

// Extract probable items from OCR text.
// Receipt formats vary, so always review the suggested data.
function extractItems() {
    const text = document.getElementById("ocrText").value;
    const lines = text.split(/\r?\n/).map(line => line.trim()).filter(Boolean);

    const found = [];
    let detectedTotal = null;

    for (const line of lines) {
        const totalMatch = line.match(
            /(?:grand\s*total|net\s*total|total\s*amount|amount\s*due|bill\s*total|total)\s*[:\-]?\s*(?:rs\.?|inr|₹)?\s*([0-9][0-9,]*(?:\.[0-9]{1,2})?)/i
        );

        if (totalMatch) {
            detectedTotal = Number(totalMatch[1].replace(/,/g, ""));
            continue;
        }

        const numbers = [
            ...line.matchAll(/(?:^|\s)(\d[\d,]*(?:\.\d{1,3})?)(?=\s|$)/g)
        ].map(match => ({
            raw: match[1],
            value: Number(match[1].replace(/,/g, ""))
        }));

        if (numbers.length === 0) continue;

        const last = numbers[numbers.length - 1];

        if (!Number.isFinite(last.value) || last.value < 0) {
            continue;
        }

        let name = line.slice(
            0,
            line.lastIndexOf(last.raw)
        ).trim();

        name = name.replace(/^[\d\s.)-]+/, "").trim();

        if (!name) continue;

        if (/^(subtotal|tax|gst|cgst|sgst|discount|cash|change)$/i.test(name)) {
            continue;
        }

        const quantity =
            numbers.length >= 2 &&
            numbers[0].value > 0 &&
            numbers[0].value <= 1000
                ? numbers[0].value
                : 1;

        const price =
            quantity > 1 && numbers.length >= 2
                ? money(last.value / quantity)
                : last.value;

        found.push({
            name,
            quantity,
            price
        });
    }

    if (found.length > 0) {
        items = found;
        renderItems();
    }

    if (detectedTotal !== null && Number.isFinite(detectedTotal)) {
        document.getElementById("paperTotal").value =
            detectedTotal.toFixed(2);
    }

    verifyTotal();

    alert(
        found.length
            ? "Items extracted. Please verify every item and price."
            : "No clear items found. Please add items manually."
    );
}

// Save bill to MySQL using Node.js API
async function saveBill() {
    if (items.length === 0) {
        alert("Add at least one item.");
        return;
    }

    const valid = items.every(item =>
        String(item.name).trim() !== "" &&
        Number.isFinite(Number(item.quantity)) &&
        Number(item.quantity) > 0 &&
        Number.isFinite(Number(item.price)) &&
        Number(item.price) >= 0
    );

    if (!valid) {
        alert("Check every item name, quantity and price.");
        return;
    }

    const paperValue =
        document.getElementById("paperTotal").value;

    const paperTotal =
        paperValue === "" ? null : Number(paperValue);

    if (
        paperTotal !== null &&
        (!Number.isFinite(paperTotal) || paperTotal < 0)
    ) {
        alert("Enter a valid paper total.");
        return;
    }

    try {
        const response = await fetch("/api/bills", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                items: items.map(item => ({
                    name: item.name.trim(),
                    quantity: Number(item.quantity),
                    unitPrice: Number(item.price)
                })),
                paperTotal
            })
        });

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || "Could not save bill.");
        }

        alert(
            "Bill saved successfully!\n" +
            "Bill ID: " + data.billId + "\n" +
            "Total: ₹" + formatMoney(data.total) + "\n" +
            "Verification: " + data.status
        );

        loadBills();

    } catch (error) {
        alert(
            error.message +
            "\nCheck that Node.js and MySQL are running."
        );
    }
}

// Load saved bills
async function loadBills() {
    const history = document.getElementById("history");

    try {
        const response = await fetch("/api/bills");
        const bills = await response.json();

        if (!response.ok) {
            throw new Error("Could not load billing history.");
        }

        if (bills.length === 0) {
            history.textContent = "No saved bills yet.";
            return;
        }

        history.innerHTML = "";

        bills.forEach(bill => {
            const div = document.createElement("div");
            div.className = "history-item";

            const title = document.createElement("strong");
            title.textContent = "Bill #" + bill.id;

            const total = document.createElement("p");
            total.textContent =
                "Total: ₹" + formatMoney(bill.calculated_total);

            const status = document.createElement("p");
            status.textContent =
                "Status: " + bill.verification_status;

            const date = document.createElement("p");
            date.textContent = new Date(bill.bill_date).toLocaleString();

            div.append(title, total, status, date);
            history.appendChild(div);
        });

    } catch (error) {
        history.textContent =
            "Could not load history. Check server and MySQL.";
    }
}

addItem();
loadBills();